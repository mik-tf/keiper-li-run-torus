import P3Lean.T4Zero1
import P3Lean.T4Zero1Data

/-!
# T4, step 1 (arcs): the chain of arcs around the circle, from the rational data of `T4Zero1Data`

Data (`T4Zero1Data`, generated by `gen_zero1.py`): Gaussian rationals `z_i` (22 chain positions, the last equals the first),
rationals `h_i` with `rho'_i ≤ 1 - h_i²/2 - 5h_i⁴/96`, and rational angle test values `lS_i < arg(z_{i+1} conj z_i) < uS_i`,
`lP < arg z_0 < uP`.  Everything is checked in `ℚ` by `decide +kernel` (`chainOK_true`); the real statement is derived from
generic lemmas whose variables are symbolic (no big literal is ever cast to `ℝ`/`ℂ`).

No arctan: `arg_lt_of` / `lt_arg_of` turn the sign of `Im (w e^{-is})` (and `Re` for the lower bound) into a bound on `arg w`,
with `sin s`, `cos s` bounded by `Real.sin_bound` (error `s^5/100`), `Real.cos_bound` (error `5 s^4/96`) for `0 ≤ s ≤ 1`.

`arcs_data`: there is `Ψ : ℕ → ℝ` with `z_i = ‖z_i‖ e^{iΨ_i}`, `‖z_i‖ > 0`, the arcs `(Ψ_i - h_i, Ψ_i + h_i)` chain
(`a (i+1) < b i`), `a 0 < 0` and `2π < b 21`.  `rho_cos`: `rho'_i ≤ cos h_i`, `0 < h_i ≤ 1`.
-/

open Complex

namespace P3Lean

noncomputable section

namespace Z1

abbrev sLq (s : ℚ) : ℚ := s - s ^ 3 / 6 - s ^ 5 / 100
abbrev sUq (s : ℚ) : ℚ := s - s ^ 3 / 6 + s ^ 5 / 100
abbrev cLq (s : ℚ) : ℚ := 1 - s ^ 2 / 2 - 5 / 96 * s ^ 4
abbrev cUq (s : ℚ) : ℚ := 1 - s ^ 2 / 2 + 5 / 96 * s ^ 4

abbrev upOK (wr wi s : ℚ) : Prop := 0 < wr ∧ 0 < wi ∧ 0 ≤ s ∧ s ≤ 1 ∧ wi * cUq s < wr * sLq s
abbrev loOK (wr wi l : ℚ) : Prop :=
  0 < wr ∧ 0 < wi ∧ 0 ≤ l ∧ l ≤ 1 ∧ 0 < cLq l ∧ wr * sUq l < wi * cLq l

lemma sin_bounds (s : ℚ) (h0 : 0 ≤ s) (h1 : s ≤ 1) :
    ((sLq s : ℚ) : ℝ) ≤ Real.sin (s : ℝ) ∧ Real.sin (s : ℝ) ≤ ((sUq s : ℚ) : ℝ) := by
  have h0' : (0 : ℝ) ≤ s := by exact_mod_cast h0
  have h1' : (s : ℝ) ≤ 1 := by exact_mod_cast h1
  have hb := Real.sin_bound (x := (s : ℝ)) (by rw [abs_of_nonneg h0']; exact h1')
  rw [abs_of_nonneg h0'] at hb
  have := abs_le.mp hb
  push_cast
  constructor <;> linarith [this.1, this.2]

lemma cos_bounds (s : ℚ) (h0 : 0 ≤ s) (h1 : s ≤ 1) :
    ((cLq s : ℚ) : ℝ) ≤ Real.cos (s : ℝ) ∧ Real.cos (s : ℝ) ≤ ((cUq s : ℚ) : ℝ) := by
  have h0' : (0 : ℝ) ≤ s := by exact_mod_cast h0
  have h1' : (s : ℝ) ≤ 1 := by exact_mod_cast h1
  have hb := Real.cos_bound (x := (s : ℝ)) (by rw [abs_of_nonneg h0']; exact h1')
  rw [abs_of_nonneg h0'] at hb
  have := abs_le.mp hb
  push_cast
  constructor <;> linarith [this.1, this.2]

/-- cos of a rational `h ∈ [0,1]` is at least `cLq h`. -/
lemma cos_ge_cLq (h : ℚ) (h0 : 0 ≤ h) (h1 : h ≤ 1) : ((cLq h : ℚ) : ℝ) ≤ Real.cos (h : ℝ) :=
  (cos_bounds h h0 h1).1

lemma arg_lt_of (w : ℂ) (s : ℝ) (hs : 0 ≤ s)
    (him : w.im * Real.cos s - w.re * Real.sin s < 0) : w.arg < s := by
  by_contra h
  push Not at h
  have h1 := Complex.arg_le_pi w
  have hsin : 0 ≤ Real.sin (w.arg - s) := Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)
  have e : w.im * Real.cos s - w.re * Real.sin s = ‖w‖ * Real.sin (w.arg - s) := by
    rw [Real.sin_sub, mul_sub, ← Complex.norm_mul_sin_arg w, ← Complex.norm_mul_cos_arg w]; ring
  rw [e] at him
  have := mul_nonneg (norm_nonneg w) hsin
  linarith

lemma lt_arg_of (w : ℂ) (l : ℝ) (hl0 : 0 ≤ l) (hl1 : l ≤ 1)
    (hre : 0 < w.re * Real.cos l + w.im * Real.sin l)
    (him : 0 < w.im * Real.cos l - w.re * Real.sin l) : l < w.arg := by
  by_contra h
  push Not at h
  have h1 := Complex.neg_pi_lt_arg w
  have eS : w.im * Real.cos l - w.re * Real.sin l = ‖w‖ * Real.sin (w.arg - l) := by
    rw [Real.sin_sub, mul_sub, ← Complex.norm_mul_sin_arg w, ← Complex.norm_mul_cos_arg w]; ring
  have eC : w.re * Real.cos l + w.im * Real.sin l = ‖w‖ * Real.cos (w.arg - l) := by
    rw [Real.cos_sub, mul_add, ← Complex.norm_mul_sin_arg w, ← Complex.norm_mul_cos_arg w]; ring
  rw [eS] at him
  rw [eC] at hre
  have hn : 0 ≤ ‖w‖ := norm_nonneg w
  have hpi := Real.pi_gt_three
  by_cases ht : -Real.pi ≤ w.arg - l
  · have : Real.sin (w.arg - l) ≤ 0 := Real.sin_nonpos_of_nonpos_of_neg_pi_le (by linarith) ht
    have := mul_nonpos_of_nonneg_of_nonpos hn this
    linarith
  · push Not at ht
    have hc : 0 < Real.cos (w.arg - l + Real.pi) :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩
    rw [Real.cos_add_pi] at hc
    have := mul_nonpos_of_nonneg_of_nonpos hn (by linarith : Real.cos (w.arg - l) ≤ 0)
    linarith

lemma arg_up (w : ℂ) (wr wi s : ℚ) (hr : w.re = wr) (hi : w.im = wi) (h : upOK wr wi s) :
    w.arg < (s : ℝ) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  have hs := sin_bounds s h3 h4
  have hc := cos_bounds s h3 h4
  have h5' : (wi : ℝ) * (cUq s : ℝ) < (wr : ℝ) * (sLq s : ℝ) := by exact_mod_cast h5
  have h2' : (0 : ℝ) < wi := by exact_mod_cast h2
  have h1' : (0 : ℝ) < wr := by exact_mod_cast h1
  apply arg_lt_of w s (by exact_mod_cast h3)
  rw [hr, hi]
  nlinarith [mul_le_mul_of_nonneg_left hc.2 h2'.le, mul_le_mul_of_nonneg_left hs.1 h1'.le]

lemma arg_lo (w : ℂ) (wr wi l : ℚ) (hr : w.re = wr) (hi : w.im = wi) (h : loOK wr wi l) :
    (l : ℝ) < w.arg := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
  have hs := sin_bounds l h3 h4
  have hc := cos_bounds l h3 h4
  have h6' : (wr : ℝ) * (sUq l : ℝ) < (wi : ℝ) * (cLq l : ℝ) := by exact_mod_cast h6
  have h5' : (0 : ℝ) < (cLq l : ℝ) := by exact_mod_cast h5
  have h2' : (0 : ℝ) < wi := by exact_mod_cast h2
  have h1' : (0 : ℝ) < wr := by exact_mod_cast h1
  have l0 : (0 : ℝ) ≤ l := by exact_mod_cast h3
  have l1 : (l : ℝ) ≤ 1 := by exact_mod_cast h4
  have hsin0 : 0 ≤ Real.sin (l : ℝ) :=
    Real.sin_nonneg_of_nonneg_of_le_pi l0 (by linarith [Real.pi_gt_three])
  apply lt_arg_of w l l0 l1
  · rw [hr, hi]
    nlinarith [mul_le_mul_of_nonneg_left hc.1 h1'.le, mul_nonneg h2'.le hsin0, mul_pos h1' (lt_of_lt_of_le h5' hc.1)]
  · rw [hr, hi]
    nlinarith [mul_le_mul_of_nonneg_left hc.1 h2'.le, mul_le_mul_of_nonneg_left hs.2 h1'.le]

/-! ### Data access -/

abbrev zr (i : ℕ) : ℚ := zRe.getD i 0
abbrev zi (i : ℕ) : ℚ := zIm.getD i 0
abbrev hq (i : ℕ) : ℚ := hL.getD i 0
abbrev rq (i : ℕ) : ℚ := rhoL.getD i 0
abbrev uq (i : ℕ) : ℚ := uSL.getD i 0
abbrev lq (i : ℕ) : ℚ := lSL.getD i 0
abbrev wrAt (i : ℕ) : ℚ := zr (i + 1) * zr i + zi (i + 1) * zi i
abbrev wiAt (i : ℕ) : ℚ := zi (i + 1) * zr i - zr (i + 1) * zi i

def sumL : ℕ → ℚ
  | 0 => 0
  | k + 1 => sumL k + lq k

abbrev chainOK : Prop :=
  (∀ i, i < 21 → upOK (wrAt i) (wiAt i) (uq i) ∧ loOK (wrAt i) (wiAt i) (lq i) ∧ uq i < hq i + hq (i + 1)) ∧
  (∀ i, i < 22 → 0 < zr i ^ 2 + zi i ^ 2 ∧ 0 < hq i ∧ hq i ≤ 1 ∧ rq i ≤ cLq (hq i)) ∧
  upOK (zr 0) (zi 0) uP ∧ loOK (zr 0) (zi 0) lP ∧ uP < hq 0 ∧
  2 * (3141593 / 1000000 : ℚ) ≤ lP + sumL 21 + hq 21 ∧
  zr 21 = zr 0 ∧ zi 21 = zi 0

theorem chainOK_true : chainOK := by decide +kernel

end Z1

open Z1

/-- the chain centres as complex numbers -/
def zc (i : ℕ) : ℂ := ⟨(zr i : ℝ), (zi i : ℝ)⟩

lemma zc_re (i : ℕ) : (zc i).re = (zr i : ℝ) := rfl
lemma zc_im (i : ℕ) : (zc i).im = (zi i : ℝ) := rfl

lemma zc_ne (i : ℕ) (h : 0 < zr i ^ 2 + zi i ^ 2) : zc i ≠ 0 := by
  intro h0
  have h1 : (zr i : ℝ) = 0 := by have := congrArg Complex.re h0; rw [zc_re, Complex.zero_re] at this; exact this
  have h2 : (zi i : ℝ) = 0 := by have := congrArg Complex.im h0; rw [zc_im, Complex.zero_im] at this; exact this
  have h1' : zr i = 0 := by exact_mod_cast h1
  have h2' : zi i = 0 := by exact_mod_cast h2
  rw [h1', h2'] at h
  norm_num at h

/-- the step `w_i = z_{i+1} conj z_i` has real and imaginary parts `wrAt i`, `wiAt i` -/
lemma step_re (i : ℕ) : (zc (i + 1) * (starRingEnd ℂ) (zc i)).re = (wrAt i : ℝ) := by
  simp [Complex.mul_re, zc] <;> (try push_cast) <;> (try ring)

lemma step_im (i : ℕ) : (zc (i + 1) * (starRingEnd ℂ) (zc i)).im = (wiAt i : ℝ) := by
  simp [Complex.mul_im, zc] <;> (try push_cast) <;> (try ring)

/-- the lifted angles -/
def Psi : ℕ → ℝ
  | 0 => (zc 0).arg
  | i + 1 => Psi i + (zc (i + 1) * (starRingEnd ℂ) (zc i)).arg

lemma polar_step (z z' : ℂ) (Ψ : ℝ) (hz0 : z ≠ 0) (hz : z = (‖z‖ : ℂ) * Complex.exp ((Ψ : ℝ) * I)) :
    z' = (‖z'‖ : ℂ) * Complex.exp (((Ψ + (z' * (starRingEnd ℂ) z).arg : ℝ)) * I) := by
  set θ := (z' * (starRingEnd ℂ) z).arg with hθ
  have hw : z' * (starRingEnd ℂ) z = ((‖z'‖ * ‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℝ) * I) := by
    have h := Complex.norm_mul_exp_arg_mul_I (z' * (starRingEnd ℂ) z)
    have hn : ‖z' * (starRingEnd ℂ) z‖ = ‖z'‖ * ‖z‖ := by simp [norm_mul]
    rw [hn] at h
    push_cast at h ⊢
    exact h.symm
  have hzz : z * (starRingEnd ℂ) z = ((‖z‖ : ℝ) : ℂ) ^ 2 := Complex.mul_conj' z
  have hn0 : ((‖z‖ : ℝ) : ℂ) ^ 2 ≠ 0 := by
    have : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz0
    exact pow_ne_zero 2 (by exact_mod_cast this)
  apply mul_right_cancel₀ hn0
  calc z' * ((‖z‖ : ℝ) : ℂ) ^ 2 = (z' * (starRingEnd ℂ) z) * z := by rw [← hzz]; ring
    _ = (((‖z'‖ * ‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℝ) * I)) * z := by rw [hw]
    _ = (((‖z'‖ * ‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℝ) * I)) * ((‖z‖ : ℂ) * Complex.exp ((Ψ : ℝ) * I)) := by
        rw [← hz]
    _ = ((‖z'‖ : ℂ) * Complex.exp (((Ψ + θ : ℝ)) * I)) * ((‖z‖ : ℝ) : ℂ) ^ 2 := by
        have : ((Ψ + θ : ℝ) : ℂ) * I = (Ψ : ℂ) * I + (θ : ℂ) * I := by push_cast; ring
        rw [this, Complex.exp_add]; push_cast; ring

lemma polar_all : ∀ i, i ≤ 21 → zc i = (‖zc i‖ : ℂ) * Complex.exp ((Psi i : ℝ) * I) := by
  intro i
  induction i with
  | zero => intro _; exact (Complex.norm_mul_exp_arg_mul_I (zc 0)).symm
  | succ k ih =>
    intro hk
    have hne := zc_ne k (chainOK_true.2.1 k (by omega)).1
    exact polar_step (zc k) (zc (k + 1)) (Psi k) hne (ih (by omega))

lemma Psi_lower : ∀ k, k ≤ 21 → ((lP + sumL k : ℚ) : ℝ) ≤ Psi k := by
  have hok := chainOK_true
  have h0 : ((lP : ℚ) : ℝ) < Psi 0 := by
    have := arg_lo (zc 0) (zr 0) (zi 0) lP (by simp [zc]) (by simp [zc]) hok.2.2.2.1
    exact this
  intro k
  induction k with
  | zero => intro _; simp [sumL]; exact h0.le
  | succ k ih =>
    intro hk
    have hs := arg_lo (zc (k + 1) * (starRingEnd ℂ) (zc k)) (wrAt k) (wiAt k) (lq k)
      (step_re k) (step_im k) (hok.1 k (by omega)).2.1
    have := ih (by omega)
    simp only [Psi, sumL]
    push_cast at this ⊢
    linarith

theorem arcs_data : ∃ Ψ : ℕ → ℝ,
    (∀ i, i < 22 → zc i = (‖zc i‖ : ℂ) * Complex.exp ((Ψ i : ℝ) * I) ∧ 0 < ‖zc i‖) ∧
    (∀ i, i + 1 < 22 → Ψ (i + 1) - (hq (i + 1) : ℝ) < Ψ i + (hq i : ℝ)) ∧
    Ψ 0 - (hq 0 : ℝ) < 0 ∧ 2 * Real.pi < Ψ 21 + (hq 21 : ℝ) := by
  have hok := chainOK_true
  refine ⟨Psi, ?_, ?_, ?_, ?_⟩
  · intro i hi
    exact ⟨polar_all i (by omega), norm_pos_iff.mpr (zc_ne i (hok.2.1 i hi).1)⟩
  · intro i hi
    have hs := arg_up (zc (i + 1) * (starRingEnd ℂ) (zc i)) (wrAt i) (wiAt i) (uq i)
      (step_re i) (step_im i) (hok.1 i (by omega)).1
    have hu := (hok.1 i (by omega)).2.2
    have hu' : ((uq i : ℚ) : ℝ) < (hq i : ℝ) + (hq (i + 1) : ℝ) := by exact_mod_cast hu
    simp only [Psi]
    linarith
  · have hs := arg_up (zc 0) (zr 0) (zi 0) uP (by simp [zc]) (by simp [zc]) hok.2.2.1
    have hu' : ((uP : ℚ) : ℝ) < (hq 0 : ℝ) := by exact_mod_cast hok.2.2.2.2.1
    simp only [Psi]
    linarith
  · have hl := Psi_lower 21 le_rfl
    have hend : ((2 * (3141593 / 1000000 : ℚ) : ℚ) : ℝ) ≤ ((lP + sumL 21 + hq 21 : ℚ) : ℝ) := by
      exact_mod_cast hok.2.2.2.2.2.1
    push_cast at hend hl
    have := Real.pi_lt_d6
    linarith

/-- `rho'_i ≤ cos h_i` for the arc half-widths. -/
theorem rho_cos (i : ℕ) (hi : i < 22) : (rq i : ℝ) ≤ Real.cos (hq i : ℝ) ∧ 0 < hq i ∧ hq i ≤ 1 := by
  have hok := (chainOK_true.2.1 i hi).2
  refine ⟨?_, hok.1, hok.2.1⟩
  have h1 := cos_ge_cLq (hq i) hok.1.le hok.2.1
  have h2 : (rq i : ℝ) ≤ ((cLq (hq i) : ℚ) : ℝ) := by exact_mod_cast hok.2.2
  linarith

end

end P3Lean
#print axioms P3Lean.arcs_data
#print axioms P3Lean.rho_cos
